# ========================================================
# StudentSphere Backend Environment Configuration
# ========================================================
# PORT for Express server
PORT=5001
NODE_ENV=development

# Target Firebase Admin UID
# Set this to the UID of the administrator account (shavni.390@gmail.com)
ADMIN_FIREBASE_UID=

# Target Firebase Admin Email for sanity checks
ADMIN_FIREBASE_EMAIL=shavni.390@gmail.com

# --------------------------------------------------------
# Firebase Admin SDK Credentials Options (Choose Option 1 or 2):
# --------------------------------------------------------
# Option 1: File path to Service Account JSON (Recommended for local dev)
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/serviceAccountKey.json

# Option 2: Inline Environment Variables (Recommended for Render, Railway, Heroku)
FIREBASE_PROJECT_ID=studentsphere-71a6a
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@studentsphere-71a6a.iam.gserviceaccount.com
# Note: In private key, replace newlines with \n
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQD...\n-----END PRIVATE KEY-----\n"

# Alternatively, the full JSON string:
# FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"studentsphere-71a6a",...}'

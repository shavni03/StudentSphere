rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Users collection rules:
    // Allow users to read and update their own document.
    // Allow designated administrator full access to read and write user documents.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (
        request.auth.uid == userId ||
        request.auth.token.email == 'shavni.390@gmail.com'
      );
    }

    // Default rule for other collections (notes, pyqs, jobs, etc.)
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
